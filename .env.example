# Base URL of the REST Assured backend API.
# Used by the frontend to make HTTP requests. No trailing slash.
#
# For local `npm run dev` (Vite dev server) point this at a running backend,
# e.g. http://localhost:8000. For the docker-compose stack, the SPA talks to
# the backend through the nginx /api proxy, so the *build* uses
# FRONTEND_API_BASE_URL below (empty = same-origin) instead of this value.
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# docker-compose variables (see docker-compose.yml)
# These are read by `docker compose` via `${VAR}` interpolation. Copy this file
# to `.env` (gitignored) and fill in real values. Never commit secrets.
# =============================================================================

# ---- Frontend (build/runtime) ----
# Build-time API base URL inlined into the SPA by Vite.
# Leave EMPTY for the recommended same-origin setup, where the browser calls
# "/api/..." on its own origin and nginx reverse-proxies to the backend.
# Set to an absolute URL only to bypass the nginx proxy.
FRONTEND_API_BASE_URL=
# Host port to publish the frontend nginx on (container always listens on 8080).
FRONTEND_HOST_PORT=8080

# ---- Backend (container config) ----
# Port the backend image listens on. Must match the nginx upstream
# (backend:<port>) in nginx/default.conf. Assumed 8000.
BACKEND_PORT=8000
# Host port if you uncomment the backend `ports:` mapping for direct access.
BACKEND_HOST_PORT=8000

# Backend application config — PLACEHOLDERS. Adjust to the backend's real
# schema. Do not commit real secrets; these live in your local .env only.
DATABASE_URL=
SECRET_KEY=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
